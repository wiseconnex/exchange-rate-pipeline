# Exchange Rate Stack — environment template
# Copy to .env and fill in

# Container prefix (Dokploy sets this)
CONTAINER_PREFIX=exchange-rate-bcueot

# === Postgres connection (shared instance) ===
POSTGRES_HOST=supabase-8954-db
POSTGRES_PORT=5432
POSTGRES_DB=exchange_rate
POSTGRES_PASSWORD=YOUR_SHARED_PG_PASSWORD

# === PostgREST ===
PGRST_DB_SCHEMAS=public

# === Auth (must match the JWT_SECRET used to sign tokens) ===
JWT_SECRET=YOUR_JWT_SECRET_BASE64
JWT_EXPIRY=3600

# === API keys (must match the rotated keys) ===
ANON_KEY=YOUR_NEW_ANON_KEY
SERVICE_ROLE_KEY=YOUR_NEW_SERVICE_ROLE_KEY

# === Kong dashboard ===
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=YOUR_DASHBOARD_PASSWORD

# === Public URL (used by Kong for redirects) ===
SUPABASE_PUBLIC_URL=https://exchange-rate-db.wiseconnex.net
SUPABASE_HOST=exchange-rate-db.wiseconnex.net
